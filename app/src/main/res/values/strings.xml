    <!-- Privacy page -->
    <string name="privacy_intro">NOVA KEYBOARD is designed so that your typing never leaves your device.</string>
    <string name="privacy_no_internet_title">No internet access</string>
    <string name="privacy_no_internet_body">The app does not request the INTERNET permission. Android therefore blocks every network call, even in third-party code.</string>
    <string name="privacy_local_title">Everything stays local</string>
    <string name="privacy_local_body">Dictionaries, the next-word model, emoji data and settings are bundled in the app or stored in this app\'s private storage. Nothing is uploaded and no account is required.</string>
    <string name="privacy_fields_title">Sensitive fields are protected</string>
    <string name="privacy_fields_body">In password, PIN and other sensitive fields the keyboard turns off learning, personalised suggestions, autocorrect and clipboard capture.</string>
    <string name="privacy_clipboard_title">Clipboard is opt-in</string>
    <string name="privacy_clipboard_body">Clipboard history is off by default. When you enable it, only clips you explicitly save (or, if you opt in, text copied while the keyboard is active) are stored locally, and you can pin, delete or clear them at any time.</string>
    <string name="privacy_backup_title">No cloud backup of learned data</string>
    <string name="privacy_backup_body">Android backup is disabled for the app, so learned words and clipboard entries are never copied to a cloud backup.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">The app declares no permissions: no internet, no contacts, no SMS, no microphone, no location, no accessibility service.</string>
    <string name="privacy_data_title">What is stored on device</string>
    <string name="privacy_data_body">• Settings and theme choices\n• Words you add to the personal dictionary\n• Words learned from your typing (only if learning is enabled)\n• Recently used emoji\n• Clipboard entries you save (only if clipboard history is enabled)</string>

